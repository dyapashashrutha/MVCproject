@{
    ViewBag.Title = "EmployeeRegistration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center" style="margin-bottom:15px;">
    <img src="~/images/logo.jpg" width="100" />
</div>

<h2 style="margin-bottom:40px; color:blue; font-size:40px;">Employee Registration</h2>

<div class="row">

    <!-- LEFT SIDE -->
    <div class="col-md-6">

        <div class="form-group">
            <label>Employee Id</label>
            <input type="text" class="form-control" id="txtEmpid" placeholder="Enter Employee Id" />
        </div>

        <div class="form-group">
            <label>Employee Name</label>
            <input type="text" class="form-control" id="txtEname" placeholder="Enter Employee name" />
        </div>

        <div class="form-group">
            <label>Mobile Number</label>
            <input type="text" class="form-control" id="txtMobile" placeholder="Enter Mobile number" />
        </div>

        <div class="form-group">
            <label>DOJ</label>
            <input type="date" id="Dateofjoining" class="form-control" />
        </div>

        <div class="form-group">
            <label>Function</label>
            <select class="form-control" id="ddlEfunction">
                <option>Select Function</option>
                <option>Software Development</option>
                <option>QA/Testing</option>
                <option>HR</option>
                <option>Finance</option>
                <option>Management</option>
            </select>
        </div>

        <div class="form-group">
            <label>Personal Email</label>
            <input type="text" class="form-control" id="txtPemail" placeholder="Enter Personal Email" />
        </div>

    </div>


    <!-- RIGHT SIDE -->
    <div class="col-md-6">

        <div class="form-group">
            <label>Email Address</label>
            <input type="text" class="form-control" id="txtEmailaddress" placeholder="Enter Email Address" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="text" class="form-control" id="txtPassword" placeholder="Enter Password" />
        </div>

        <div class="form-group">
            <label>Employee Type</label>
            <select class="form-control" id="ddlEtype">
                <option>Select Type</option>
                <option>Full-Time</option>
                <option>Part-Time</option>
                <option>Intern</option>
                <option>Contract</option>
                <option>Temporary</option>
            </select>
        </div>

        <div class="form-group">
            <label>Employee Status</label>
            <select class="form-control" id="ddlEstatus">
                <option>Select Status</option>
                <option>Active</option>
                <option>Inactive</option>
                <option>Terminated</option>
                <option>On Leave</option>
                <option>Retired</option>
            </select>
        </div>

        <div class="form-group">
            <label>Employee Address</label>
            <textarea class="form-control" id="txtEmpaddress" rows="3" placeholder="Enter Address"></textarea>
        </div>

        <button id="btnSignUp" class="btn btn-primary">Sign Up</button>

    </div>

</div>

<br />

<div>
    <img src="~/images/Employee.jpg" width="300" />
</div>


@section scripts{
    <script>

        $(document).on('click', '#btnSignUp', function () {

            var data = {

                empid: $('#txtEmpid').val(),
                empname: $('#txtEname').val(),
                mobilenumber: $('#txtMobile').val(),
                doj: $('#Dateofjoining').val(),
                empfunction: $('#ddlEfunction').val(),
                personalemail: $('#txtPemail').val(),
                emailaddress: $('#txtEmailaddress').val(),
                emppassword: $('#txtPassword').val(),
                emptype: $('#ddlEtype').val(),
                empstatus: $('#ddlEstatus').val(),
                empaddress: $('#txtEmpaddress').val()

            };

            $.ajax({

                type: "POST",
                url: "/Employee/Insert",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(data),
                dataType: "json",

                success: function (msg) {

                    if (msg == "Success") {
                        alert("Data saved successfully");
                    }
                    else {
                        alert("Error saving data");
                    }

                },

                error: function () {
                    alert("Error try again");
                }

            });

        });

    </script>
}